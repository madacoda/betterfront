{
  "name": "betterfront",
  "version": "1.1.0",
  "description": "Gold-Standard Autonomous Frontend QA, Visual Layout Geometry & Customizable UAT Workflow Engine",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "betterfront": "./bin/betterfront.js"
  },
  "files": [
    "dist",
    "bin",
    "uat-scenarios/uat-scenario.schema.json",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=18.0.0"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "clean": "bun -e \"import fs from 'fs'; fs.rmSync('./dist', { recursive: true, force: true })\"",
    "typecheck": "bunx tsc --noEmit && bunx tsc --noEmit -p studio/tsconfig.json",
    "build:core": "bunx tsc",
    "build:studio": "bunx --bun vite build --config studio/vite.config.ts",
    "build": "bun run build:core && bun run build:studio",
    "prepublishOnly": "bun run clean && bun run build",
    "dev": "bun src/cli.ts",
    "audit": "bun src/cli.ts audit",
    "uat": "bun src/cli.ts uat",
    "record": "bun src/cli.ts record",
    "explore": "bun src/cli.ts explore",
    "studio": "bun src/cli.ts studio",
    "studio:dev": "bunx --bun vite --config studio/vite.config.ts",
    "test": "bun test --timeout 240000 tests/audit.test.js tests/uat.test.js tests/variants.test.js tests/studio-and-webchecks.test.js",
    "test:audit": "bun test --timeout 240000 tests/audit.test.js",
    "test:uat": "bun test --timeout 240000 tests/uat.test.js",
    "test:variants": "bun test --timeout 240000 tests/variants.test.js",
    "test:studio": "bun test --timeout 240000 tests/studio-and-webchecks.test.js"
  },
  "keywords": [
    "frontend-testing",
    "qa",
    "uat",
    "e2e-testing",
    "visual-regression",
    "text-overlap",
    "layout-shift",
    "cls",
    "wcag",
    "accessibility",
    "lighthouse",
    "playwright",
    "autonomous-agent",
    "sarif",
    "junit"
  ],
  "author": "BetterFront Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/madacoda/betterfront.git"
  },
  "bugs": {
    "url": "https://github.com/madacoda/betterfront/issues"
  },
  "homepage": "https://github.com/madacoda/betterfront#readme",
  "dependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@faker-js/faker": "^9.5.0",
    "commander": "^13.1.0",
    "lighthouse": "^12.3.0",
    "playwright": "^1.50.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.2",
    "vite": "^8.3.5"
  }
}
