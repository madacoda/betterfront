{
  "$schema": "./uat-scenario.schema.json",
  "name": "03 - Dreamblu AFK Idle Yield & Quick Claim Engine",
  "description": "Performs authenticated AFK resource harvesting: validates idle time calculation, executes 2H Fast-Forward Quick Claim, triggers full passive yield collection, verifies balance increments, and checks layout stability on http://localhost:7777/afk-rewards.",
  "startUrl": "http://localhost:7777",
  "viewports": [
    "desktop_fhd"
  ],
  "anomalyChecks": {
    "textOverlap": true,
    "horizontalBleed": true,
    "containerClipping": true
  },
  "recording": {
    "video": true,
    "trace": true,
    "screenshotOnFailure": true,
    "artifactsDir": "./betterfront-artifacts"
  },
  "steps": [
    {
      "action": "GOTO",
      "url": "http://localhost:7777",
      "description": "1. Open Dreamblu Fantasy Homepage"
    },
    {
      "action": "CLICK",
      "selector": "button.save-button",
      "description": "2. Click Guest Login to open auth modal"
    },
    {
      "action": "WAIT_FOR",
      "selector": "input[type='email']",
      "description": "3. Wait for email field"
    },
    {
      "action": "TYPE",
      "selector": "input[type='email']",
      "text": "user@example.com",
      "description": "4. Enter user@example.com"
    },
    {
      "action": "TYPE",
      "selector": "input[type='password']",
      "text": "Password123",
      "description": "5. Enter Password123"
    },
    {
      "action": "CLICK",
      "selector": "button:has-text('SIGN IN TO ACCOUNT')",
      "description": "6. Submit login"
    },
    {
      "action": "WAIT_FOR",
      "selector": "button:has-text('Lucio')",
      "timeoutMs": 10000,
      "description": "7. Wait for authenticated user badge 'Lucio ▾'"
    },
    {
      "action": "GOTO",
      "url": "http://localhost:7777/afk-rewards",
      "description": "8. Navigate to AFK Idle Rewards (/afk-rewards)"
    },
    {
      "action": "WAIT_FOR",
      "selector": "h1",
      "description": "9. Wait for AFK page header"
    },
    {
      "action": "ASSERT_TEXT",
      "selector": "h1",
      "text": "AFK Idle Rewards",
      "description": "10. Assert H1 text: 'AFK Idle Rewards'"
    },
    {
      "action": "ASSERT_VISIBLE",
      "selector": "button:has-text('QUICK CLAIM 2H')",
      "description": "11. Verify 'QUICK CLAIM 2H' action button is present"
    },
    {
      "action": "ASSERT_VISIBLE",
      "selector": "button:has-text('CLAIM PASSIVE YIELD')",
      "description": "12. Verify 'CLAIM PASSIVE YIELD' action button is present"
    },
    {
      "action": "SCREENSHOT",
      "name": "03-afk-pre-claim-state",
      "description": "13. Capture pre-claim idle accumulation state"
    },
    {
      "action": "CLICK",
      "selector": "button:has-text('QUICK CLAIM 2H')",
      "description": "14. Click 'QUICK CLAIM 2H (FREE)'"
    },
    {
      "action": "WAIT",
      "waitMs": 1500,
      "description": "15. Allow quick claim animation and currency dispatch to complete"
    },
    {
      "action": "SCREENSHOT",
      "name": "03-afk-post-quick-claim",
      "description": "16. Capture post-quick claim state"
    },
    {
      "action": "CLICK",
      "selector": "button:has-text('CLAIM PASSIVE YIELD')",
      "description": "17. Click 'CLAIM PASSIVE YIELD' to harvest accumulated yields"
    },
    {
      "action": "WAIT",
      "waitMs": 1500,
      "description": "18. Allow passive yield claim and timer reset"
    },
    {
      "action": "ASSERT_NO_BLEED",
      "description": "19. Assert zero horizontal bleed on AFK rewards page"
    },
    {
      "action": "ASSERT_NO_CLIPPING",
      "selector": "header.site-topbar",
      "description": "20. Assert zero topbar clipping"
    },
    {
      "action": "SCREENSHOT",
      "name": "03-afk-harvest-complete",
      "description": "21. Capture final harvested AFK idle state"
    }
  ]
}
